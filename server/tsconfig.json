{
    "compilerOptions": {
        "target": "es2016", /* לאיזו גרסת JS לקמפל */
        "module": "commonjs", /* Node.js עובד עם CommonJS */
        "rootDir": "./src", /* איפה הקוד שלך יושב */
        "outDir": "./dist", /* לאן הקוד המקומפל ילך */
        "esModuleInterop": true, /* מאפשר אימפורטים נוחים */
        "forceConsistentCasingInFileNames": true,
        "strict": true, /* מצב קשוח - מונע באגים */
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}